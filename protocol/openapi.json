{
  "openapi": "3.1.0",
  "info": { "title": "AgenticDriver SDK protocol", "version": "1.0.0" },
  "servers": [
    { "url": "https://driver.example.com" },
    { "url": "http://127.0.0.1:7433", "description": "Loopback development" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Host health and protocol version",
            "headers": {
              "AgenticDriver-Version": {
                "schema": { "const": "1.0" },
                "description": "The host's selected wire version."
              }
            }
          }
        }
      }
    },
    "/v1/providers": {
      "get": {
        "operationId": "listProviders",
        "parameters": [
          { "$ref": "#/components/parameters/ProtocolVersion" },
          { "$ref": "#/components/parameters/OptionalEvents" },
          {
            "name": "refresh",
            "in": "query",
            "schema": { "const": "true" },
            "description": "Refresh account health and model inventory, subject to the host's minimum refresh interval. Omit to use the normal cache."
          }
        ],
        "responses": {
          "200": {
            "description": "Only provider instances allowed by this token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["providers"],
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Provider" }
                    }
                  }
                }
              }
            },
            "headers": {
              "AgenticDriver-Version": {
                "schema": { "const": "1.0" },
                "description": "The host's selected wire version."
              }
            }
          },
          "default": {
            "description": "Authentication, validation, capacity, or execution failure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "AgenticDriver-Version": {
                "schema": { "const": "1.0" },
                "description": "The host's selected wire version."
              }
            }
          }
        }
      }
    },
    "/v1/protocol": {
      "get": {
        "operationId": "getProtocol",
        "parameters": [
          { "$ref": "#/components/parameters/ProtocolVersion" },
          { "$ref": "#/components/parameters/OptionalEvents" }
        ],
        "description": "Authenticated wire-version and host-feature discovery. An omitted version header selects the original 1.0 contract.",
        "responses": {
          "200": {
            "description": "Supported protocol versions and host features",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProtocolInfo" }
              }
            },
            "headers": {
              "AgenticDriver-Version": {
                "schema": { "const": "1.0" },
                "description": "The host's selected wire version."
              }
            }
          },
          "default": {
            "description": "Authentication, validation, capacity, or execution failure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "AgenticDriver-Version": {
                "schema": { "const": "1.0" },
                "description": "The host's selected wire version."
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "run",
        "parameters": [
          { "$ref": "#/components/parameters/ProtocolVersion" },
          { "$ref": "#/components/parameters/OptionalEvents" }
        ],
        "description": "Accept: application/json for one result; text/event-stream for ordered events. Disconnect cancels an unfinished run. No retries, reconnection, or resumable server state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RunRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed JSON result or an SSE stream with one terminal event",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunResult" }
              },
              "text/event-stream": {
                "schema": { "type": "string" },
                "description": "SSE data is a JSON RunEvent; id is its sequence; event is its type."
              }
            },
            "headers": {
              "AgenticDriver-Version": {
                "schema": { "const": "1.0" },
                "description": "The host's selected wire version."
              }
            }
          },
          "default": {
            "description": "Authentication, validation, capacity, or execution failure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "AgenticDriver-Version": {
                "schema": { "const": "1.0" },
                "description": "The host's selected wire version."
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ProtocolVersion": {
        "name": "AgenticDriver-Version",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "default": "1.0" },
        "description": "Exact wire version to select. Unsupported values fail before provider/tool execution. Independent of package versions."
      },
      "OptionalEvents": {
        "name": "AgenticDriver-Accept-Optional-Events",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["true", "false"],
          "default": "false"
        },
        "description": "Opt in to unknown advisory event types marked optional:true. Older clients omit this header and receive only the original event types."
      }
    },
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "ProviderHealth": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "unauthenticated",
              "unavailable",
              "unsupported",
              "unknown"
            ]
          },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": ["status", "code", "message", "checkedAt"]
      },
      "ModelCatalog": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": ["provider", "configured", "unavailable"]
          },
          "models": {
            "maxItems": 1000,
            "type": "array",
            "items": { "type": "string" }
          },
          "complete": { "type": "boolean" }
        },
        "required": ["source", "models", "complete"]
      },
      "RunRequest": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          },
          "model": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,199}$"
          },
          "input": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "instructions": { "type": "string", "maxLength": 100000 },
          "history": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant"] },
                "content": { "type": "string", "maxLength": 100000 }
              },
              "required": ["role", "content"],
              "additionalProperties": false
            }
          },
          "tools": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
            }
          },
          "requiredCapabilities": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,79}$"
            }
          },
          "maxSteps": { "type": "integer", "minimum": 1, "maximum": 64 },
          "maxOutputTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "idleTimeoutMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "outputSchema": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {}
          },
          "metadata": {
            "type": "object",
            "propertyNames": { "type": "string", "maxLength": 80 },
            "additionalProperties": { "type": "string", "maxLength": 500 }
          }
        },
        "required": ["provider", "model", "input"],
        "additionalProperties": false
      },
      "ProtocolInfo": {
        "type": "object",
        "required": ["protocol", "version", "supportedVersions", "features"],
        "properties": {
          "protocol": { "const": "agenticdriver" },
          "version": { "type": "string" },
          "supportedVersions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "features": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cachedInputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reasoningTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "costUsd": { "type": "number", "minimum": 0 }
        },
        "description": "Measurements are omitted when unknown. Cached input is a subset of input tokens. Totals are omitted if any model step lacks that measurement."
      },
      "RunResult": {
        "type": "object",
        "required": [
          "runId",
          "provider",
          "model",
          "text",
          "usage",
          "steps",
          "finishReason"
        ],
        "properties": {
          "runId": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "text": { "type": "string" },
          "output": {},
          "usage": { "$ref": "#/components/schemas/Usage" },
          "steps": { "type": "integer", "minimum": 1 },
          "finishReason": { "enum": ["stop", "length"] }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/ErrorInfo" } }
      },
      "ErrorInfo": {
        "type": "object",
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" }
        },
        "description": "Stable code, displayable message and retryability hint. Clients preserve unknown codes; retryable never authorizes automatic replay of tool effects."
      },
      "Provider": {
        "type": "object",
        "required": ["id", "name", "vendor", "authMode", "capabilities"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "vendor": { "type": "string" },
          "authMode": { "enum": ["api-key", "cli-session", "none"] },
          "models": { "type": "array", "items": { "type": "string" } },
          "usageStatId": { "type": "string" },
          "health": { "$ref": "#/components/schemas/ProviderHealth" },
          "modelCatalog": { "$ref": "#/components/schemas/ModelCatalog" },
          "capabilities": {
            "type": "object",
            "required": ["tools", "textStreaming"],
            "properties": {
              "tools": { "type": "boolean" },
              "textStreaming": { "type": "boolean" }
            },
            "additionalProperties": { "type": "boolean" }
          }
        }
      },
      "RunEvent": {
        "type": "object",
        "required": ["type", "runId", "sequence", "timestamp"],
        "properties": {
          "type": { "type": "string" },
          "runId": { "type": "string" },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "optional": {
            "type": "boolean",
            "description": "An unknown type may be skipped only when optional is explicitly true; its envelope and sequence must still be validated."
          }
        },
        "oneOf": [
          {
            "properties": {
              "type": { "const": "run.started" },
              "provider": { "type": "string" },
              "model": { "type": "string" }
            },
            "required": ["provider", "model"]
          },
          {
            "properties": {
              "type": { "const": "step.started" },
              "step": { "type": "integer", "minimum": 1 }
            },
            "required": ["step"]
          },
          {
            "properties": {
              "type": { "const": "text.delta" },
              "text": { "type": "string" }
            },
            "required": ["text"]
          },
          {
            "properties": {
              "type": { "const": "run.progress" },
              "phase": { "enum": ["model", "tool"] }
            },
            "required": ["phase"]
          },
          {
            "properties": {
              "type": { "const": "tool.called" },
              "call": {
                "type": "object",
                "required": ["id", "name", "arguments"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "arguments": { "type": "object" }
                }
              }
            },
            "required": ["call"]
          },
          {
            "properties": {
              "type": { "const": "tool.completed" },
              "callId": { "type": "string" },
              "output": {}
            },
            "required": ["callId", "output"]
          },
          {
            "properties": {
              "type": { "const": "usage.reported" },
              "step": { "type": "integer", "minimum": 1 },
              "usage": { "$ref": "#/components/schemas/Usage" }
            },
            "required": ["step", "usage"]
          },
          {
            "properties": {
              "type": { "const": "run.completed" },
              "result": { "$ref": "#/components/schemas/RunResult" }
            },
            "required": ["result"]
          },
          {
            "properties": {
              "type": { "enum": ["run.failed", "run.cancelled"] },
              "error": { "$ref": "#/components/schemas/ErrorInfo" }
            },
            "required": ["error"]
          },
          {
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "run.started",
                    "step.started",
                    "text.delta",
                    "run.progress",
                    "tool.called",
                    "tool.completed",
                    "usage.reported",
                    "run.completed",
                    "run.failed",
                    "run.cancelled"
                  ]
                }
              },
              "optional": { "const": true }
            },
            "required": ["optional"],
            "description": "Advisory extension. Hosts send new event types only to clients that explicitly accept optional events. They cannot carry required state transitions or actions."
          }
        ]
      }
    }
  }
}
