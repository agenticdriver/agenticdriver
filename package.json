{
  "name": "agenticdriver",
  "version": "0.1.0",
  "description": "Bring-your-own-agent SDK for local and remote applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hashimkarim/agenticdriver.git"
  },
  "homepage": "https://github.com/hashimkarim/agenticdriver#readme",
  "bugs": "https://github.com/hashimkarim/agenticdriver/issues",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agenticdriver": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "import": "./dist/better-auth.js"
    },
    "./pairing": {
      "types": "./dist/pairing.d.ts",
      "import": "./dist/pairing.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./provider-kit": {
      "types": "./dist/provider-kit.d.ts",
      "import": "./dist/provider-kit.js"
    },
    "./provider-conformance": {
      "types": "./dist/provider-conformance.d.ts",
      "import": "./dist/provider-conformance.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry.d.ts",
      "import": "./dist/opentelemetry.js"
    },
    "./usagestat": {
      "types": "./dist/usagestat.d.ts",
      "import": "./dist/usagestat.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./provider-assets": {
      "types": "./dist/provider-assets.d.ts",
      "import": "./dist/provider-assets.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./retrieval": {
      "types": "./dist/retrieval.d.ts",
      "import": "./dist/retrieval.js"
    },
    "./ingestion": {
      "types": "./dist/ingestion.d.ts",
      "import": "./dist/ingestion.js"
    }
  },
  "files": [
    "dist",
    "protocol",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples/javascript",
    "examples/quickstart"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx examples/brandstorm.ts",
    "demo:server": "tsx examples/server.ts",
    "test:clients": "python3 scripts/test-clients.py",
    "test:python": "python3 scripts/test-clients.py --python-only",
    "test:rust": "python3 scripts/test-clients.py --rust-only",
    "test:install": "tsx scripts/test-install.ts",
    "test:auth": "npm run build && npm ci --prefix integrations/better-auth && npm test --prefix integrations/better-auth",
    "test:deployment": "python3 scripts/test-deployment.py",
    "test:usagestat": "tsx scripts/test-usagestat.ts",
    "check:antigravity": "tsx scripts/check-antigravity.ts",
    "protocol": "tsx scripts/protocol.ts",
    "format": "prettier --write src tests examples protocol docs README.md package.json tsconfig*.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "types": "./dist/index.d.ts"
}
