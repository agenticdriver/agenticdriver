+++ b/internal/config/agenticdriver_timeouts_test.go
@@ -0,0 +1,36 @@
+package config
+
+import "testing"
+
+func TestAgenticDriverExplicitDisabledTimeouts(t *testing.T) {
+	zero := 0
+	timeouts := &PartialAgentTimeoutConfig{
+		PlannerSeconds: &zero, WorkerSeconds: &zero, ReviewerSeconds: &zero, FixerSeconds: &zero,
+		PlannerIdleTimeoutSeconds: &zero, PlannerMaxRuntimeSeconds: &zero,
+		WorkerIdleTimeoutSeconds: &zero, WorkerMaxRuntimeSeconds: &zero,
+		ReviewerIdleTimeoutSeconds: &zero, ReviewerMaxRuntimeSeconds: &zero,
+		FixerIdleTimeoutSeconds: &zero, FixerMaxRuntimeSeconds: &zero,
+	}
+	cfg, err := Normalize(t.TempDir(), PartialConfig{Agent: &PartialAgentConfig{Timeouts: timeouts}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ValidateWithOptions(cfg, ValidateOptions{DefaultWorktreeRoot: t.TempDir()}); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Agent.Timeouts != (AgentTimeoutConfig{}) {
+		t.Fatalf("disabled timeouts replaced: %#v", cfg.Agent.Timeouts)
+	}
+}
+
+func TestAgenticDriverNegativeTimeoutStillRejected(t *testing.T) {
+	negative := -1
+	cfg, err := Normalize(t.TempDir(), PartialConfig{Agent: &PartialAgentConfig{Timeouts: &PartialAgentTimeoutConfig{WorkerIdleTimeoutSeconds: &negative}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = ValidateWithOptions(cfg, ValidateOptions{DefaultWorktreeRoot: t.TempDir()})
+	if err == nil {
+		t.Fatal("negative inactivity timeout was accepted")
+	}
+}
